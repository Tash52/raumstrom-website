# Kopieren nach .env und ausfüllen. .env wird nie committet.
# Der Server startet nicht, solange ein Pflichtwert fehlt oder ein Platzhalter ist (fail-secure).
# Zufallswerte erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Build: öffentliche Adresse, Standard https://<domain aus firma.yaml>. Nur für abweichende Hosts
# (z. B. Staging) als Umgebungsvariable beim Build setzen, nicht in .env (Astro liest sie dort nicht).
# SITE_URL=https://raumstrom.de

# Server
HOST=127.0.0.1
PORT=8080
# true nur hinter einem Reverse-Proxy, der X-Forwarded-For setzt
TRUST_PROXY=false

# Bot-Schutz (ALTCHA, selbst gehostet) und CSRF-Token des Kontaktformulars (je mindestens 32 Zeichen, zufällig,
# zwei verschiedene Werte). Ein Wechsel macht nur offene Formulare ungültig, gespeichert wird nichts.
ALTCHA_HMAC_KEY=
CSRF_SECRET=

# Mailversand (SMTP mit TLS, deutscher Anbieter). Absender immer eine Adresse der eigenen Domain.
SMTP_HOST=
# 465 = TLS (SMTP_SECURE=true), 587 = STARTTLS (SMTP_SECURE=false)
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Empfänger der Anfragen steht in src/content/settings/firma.yaml (kontakt.anfragen_empfaenger).
# Nur Staging/Tests: Ersatz-Empfänger, solange dort noch ein Platzhalter steht (wird danach ignoriert).
MAIL_TO_STAGING=

# Nur nötig, wenn floorplan_ai in src/content/settings/features.yaml aktiv ist
MISTRAL_API_KEY=
