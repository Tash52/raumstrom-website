---
// 404 (served by the server for unknown paths). Texts from pages/404.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/base/Button.astro';
import Markdown from '../components/sections/Markdown.astro';
import Seitenkopf from '../components/sections/Seitenkopf.astro';
import { abschnitt, getSeite } from '../components/sections/seiten.ts';

const seite = await getSeite('404');
const hinweis = abschnitt(seite, 'hinweis');
---
<BaseLayout title={seite.data.meta_title} description={seite.data.meta_description} noindex>
  <Seitenkopf titel={hinweis.titel} />
  <section class="nicht-gefunden" aria-label="Weiter">
    <div class="container container-text">
      <Markdown text={hinweis.text} />
      <div class="cluster aktionen">
        <Button href="/" icon="arrow-right">Zur Startseite</Button>
        <Button href="/leistungen/" variante="sekundaer">Leistungen ansehen</Button>
        <Button href="/kontakt/" variante="sekundaer">Anfrage stellen</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nicht-gefunden {
    padding-bottom: var(--section-y);
  }

  .aktionen {
    margin-top: var(--space-5);
  }
</style>
