{
  "$id": "https://raumstrom.de/schemas/trend.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "beschreibung": {
      "type": "string",
      "minLength": 1
    },
    "gueltig_ab": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "saison": {
      "type": "string",
      "pattern": "^\\d{4}(\\/\\d{2})?$"
    },
    "trend_quelle_notiz": {
      "type": "string",
      "minLength": 1
    },
    "aktiv": {
      "type": "boolean"
    },
    "wandfarben": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "name",
          "hex"
        ]
      }
    },
    "putz_tapete": {
      "type": "object",
      "properties": {
        "art": {
          "type": "string",
          "enum": [
            "putz",
            "tapete",
            "farbe"
          ]
        },
        "beschreibung": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "art",
        "beschreibung"
      ]
    },
    "boden": {
      "type": "object",
      "properties": {
        "material": {
          "type": "string",
          "enum": [
            "vinyl",
            "laminat",
            "parkett",
            "fliese",
            "teppich"
          ]
        },
        "farbton": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "name",
            "hex"
          ]
        },
        "verlegemuster": {
          "type": "string"
        }
      },
      "required": [
        "material",
        "farbton"
      ]
    },
    "fliesen": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "farbe": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "hex": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          },
          "required": [
            "name",
            "hex"
          ]
        },
        "verlegemuster": {
          "type": "string"
        },
        "fuge": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "format",
        "farbe"
      ]
    },
    "deckenlicht": {
      "type": "object",
      "properties": {
        "art": {
          "type": "string",
          "minLength": 1
        },
        "farbtemperatur_k": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 6500
        }
      },
      "required": [
        "art",
        "farbtemperatur_k"
      ]
    },
    "elektro_vorschlag": {
      "type": "object",
      "properties": {
        "paket": {
          "type": "string",
          "minLength": 1
        },
        "punkte": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "paket",
        "punkte"
      ]
    }
  },
  "required": [
    "name",
    "beschreibung",
    "gueltig_ab",
    "saison",
    "trend_quelle_notiz",
    "aktiv",
    "wandfarben",
    "putz_tapete",
    "boden",
    "deckenlicht",
    "elektro_vorschlag"
  ],
  "title": "RAUMSTROM Stilpaket",
  "description": "Ein Stilpaket unter src/content/trends/*.json"
}
