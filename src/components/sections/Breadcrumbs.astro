---
// Breadcrumb trail. The last entry is the current page (no link, aria-current).
interface Props {
  pfad: { text: string; href?: string }[];
}
const { pfad } = Astro.props;
const alle = [{ text: 'Start', href: '/' }, ...pfad];
---
<nav class="brot" aria-label="Brotkrumen">
  <ol role="list">
    {
      alle.map((e, i) => (
        <li>
          {i < alle.length - 1 && e.href ? <a href={e.href}>{e.text}</a> : <span aria-current="page">{e.text}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .brot ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .brot li {
    display: inline-flex;
    gap: var(--space-2);
  }

  .brot li + li::before {
    content: '/';
    color: var(--line-strong);
  }

  .brot a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  .brot a:hover {
    color: var(--text);
  }

  .brot [aria-current] {
    color: var(--text);
  }
</style>
