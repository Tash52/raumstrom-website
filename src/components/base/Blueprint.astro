---
// Blueprint illustration in the brand design: stands in for missing team photos and reference images
// (Briefing 11.3). Floor-plan line drawing on Graphit; the cable enters through the door and ends in a point.
// team: 4:5 with initials · referenz: 4:3, always marked "Illustration" (no real project photo).
// Fixed aspect ratio (no layout shift). Inline SVG, presentation attributes and classes only (CSP).
import MonoLabel from './MonoLabel.astro';

interface Props {
  variante: 'team' | 'referenz';
  /** Accessible description, e.g. "Illustration als Platzhalter für das Foto von …". */
  alt: string;
  /** Team: name for the initials; Referenz: varies the floor plan. */
  name?: string;
  /** Optional technical caption inside the drawing (e.g. "Wohnung, 3 Zimmer"). */
  beschriftung?: string;
  class?: string;
}
const { variante, alt, name = '', beschriftung, class: className } = Astro.props;

const hash = [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const layout = hash % 3;
const initialen = name
  .replace(/\[\[.*?\]\]/g, '')
  .split(/\s+/)
  .filter(Boolean)
  .map((w) => w[0]!.toUpperCase())
  .slice(0, 2)
  .join('');

// Team: one room, door position and cable route vary per person.
const team = [
  { tuer: 'M80 330 H150 M210 330 H320 V90 H80 V330', bogen: 'M150 270 A60 60 0 0 1 210 330', kabel: 'M180 362 V240 H250 V181', punkt: [250, 166] },
  { tuer: 'M320 150 V90 H80 V330 H320 V210', bogen: 'M260 210 A60 60 0 0 1 320 150', kabel: 'M380 180 H200 V151', punkt: [200, 136] },
  { tuer: 'M80 200 V90 H320 V330 H80 V260', bogen: 'M140 260 A60 60 0 0 0 80 200', kabel: 'M20 230 H160 V160 H239', punkt: [254, 160] },
][layout]!;

// Referenz: apartment with several rooms, cable runs from the meter cabinet through all rooms.
const referenz = [
  { waende: 'M40 40 H360 V260 H40 Z M200 40 V150 M200 190 V260 M40 150 H120 M160 150 H260 M300 150 H360', kabel: 'M60 240 V170 H200 V90 H320', punkt: [320, 90] },
  { waende: 'M40 40 H360 V260 H40 Z M150 40 V260 M150 120 H360 M260 120 V260', kabel: 'M60 230 H120 V80 H300 V200', punkt: [300, 200] },
  { waende: 'M40 40 H360 V260 H40 Z M240 40 V110 M240 150 V260 M40 170 H200 M240 170 H360', kabel: 'M70 70 H220 V210 H330', punkt: [330, 210] },
][layout]!;
const label = variante === 'referenz' && !/illustration/i.test(alt) ? `Illustration: ${alt}` : alt;
const viewBox = variante === 'team' ? '0 0 400 500' : '0 0 400 300';
---
<div class:list={['blueprint', `blueprint-${variante}`, 'flaeche-graphit-2', className]} role="img" aria-label={label}>
  <svg viewBox={viewBox} aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
    {
      variante === 'team' ? (
        <>
          <path class="bp-hilfslinie" d="M80 60 H320 M80 52 V68 M320 52 V68" />
          <path class="bp-wand" d={team.tuer} />
          <path class="bp-bogen" d={team.bogen} />
          <path class="bp-kabel" d={team.kabel} />
          <circle class="bp-punkt-glow" cx={team.punkt[0]} cy={team.punkt[1]} r="16" />
          <circle class="bp-punkt" cx={team.punkt[0]} cy={team.punkt[1]} r="7" />
          {initialen && (
            <text class="bp-initialen" x="80" y="430">
              {initialen}
            </text>
          )}
        </>
      ) : (
        <>
          <path class="bp-hilfslinie" d="M40 22 H360 M40 14 V30 M360 14 V30" />
          <path class="bp-wand" d={referenz.waende} />
          <path class="bp-kabel" d={referenz.kabel} />
          <circle class="bp-punkt-glow" cx={referenz.punkt[0]} cy={referenz.punkt[1]} r="14" />
          <circle class="bp-punkt" cx={referenz.punkt[0]} cy={referenz.punkt[1]} r="6" />
        </>
      )
    }
  </svg>
  <div class="blueprint-fuss">
    {variante === 'referenz' && <MonoLabel variante="marke" ton="text">Illustration</MonoLabel>}
    {beschriftung && <MonoLabel ton="muted">{beschriftung}</MonoLabel>}
  </div>
</div>

<style>
  .blueprint {
    position: relative;
    display: grid;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-s);
    background-color: var(--surface);
    /* Blueprint grid: 24 px minor, 120 px major lines */
    background-image:
      linear-gradient(rgb(244 241 235 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(244 241 235 / 0.07) 1px, transparent 1px),
      linear-gradient(rgb(244 241 235 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(244 241 235 / 0.035) 1px, transparent 1px);
    background-size:
      120px 120px,
      120px 120px,
      24px 24px,
      24px 24px;
    background-position: -1px -1px;
  }

  .blueprint-team {
    aspect-ratio: 4 / 5;
  }

  .blueprint-referenz {
    aspect-ratio: 4 / 3;
  }

  .blueprint svg {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    padding: 6%;
  }

  .bp-wand {
    fill: none;
    stroke: var(--color-kalk);
    stroke-opacity: 0.78;
    stroke-width: 6;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .bp-bogen,
  .bp-hilfslinie {
    fill: none;
    stroke: var(--color-kalk);
    stroke-opacity: 0.35;
    stroke-width: 1.25;
    stroke-dasharray: 4 5;
  }

  .bp-hilfslinie {
    stroke-dasharray: none;
  }

  .bp-kabel {
    fill: none;
    stroke: var(--color-strom);
    stroke-width: 3;
    stroke-linejoin: miter;
  }

  .bp-punkt {
    fill: var(--color-strom);
  }

  .bp-punkt-glow {
    fill: var(--color-strom);
    opacity: 0.18;
  }

  .bp-initialen {
    fill: var(--color-kalk);
    font-family: var(--font-sans);
    font-size: 72px;
    font-weight: var(--weight-display);
    font-stretch: var(--wdth-display);
    letter-spacing: -0.02em;
  }

  .blueprint-fuss {
    grid-area: 1 / 1;
    align-self: end;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .blueprint-fuss:empty {
    display: none;
  }

  @media (forced-colors: active) {
    .bp-wand,
    .bp-kabel,
    .bp-bogen,
    .bp-hilfslinie {
      stroke: CanvasText;
    }
    .bp-punkt,
    .bp-initialen {
      fill: CanvasText;
    }
  }
</style>
