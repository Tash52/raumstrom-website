---
// Single-line input. Label above, optional hint, error below (aria-invalid + aria-describedby).
import type { HTMLAttributes } from 'astro/types';
import FeldFehler from './FeldFehler.astro';
import { describedBy, feldIds } from './feld.ts';

interface Props extends Omit<HTMLAttributes<'input'>, 'class' | 'type' | 'name' | 'id'> {
  name: string;
  label: string;
  typ?: 'text' | 'email' | 'tel' | 'url' | 'number' | 'date' | 'search';
  hinweis?: string;
  fehler?: string;
  id?: string;
  class?: string;
}
const { name, label, typ = 'text', hinweis, fehler, id, required, class: className, ...rest } = Astro.props;
const ids = feldIds(name, id);
---
<div class:list={['feld', className]}>
  <label class="feld-label" for={ids.id}>{label}{required && <span class="feld-pflicht"> (Pflichtfeld)</span>}</label>
  {hinweis && <p class="feld-hinweis" id={ids.hinweis}>{hinweis}</p>}
  <input
    class="feld-input"
    id={ids.id}
    name={name}
    type={typ}
    required={required}
    aria-invalid={fehler ? 'true' : undefined}
    aria-describedby={describedBy(ids, hinweis, fehler)}
    {...rest}
  />
  <FeldFehler id={ids.fehler} text={fehler} />
</div>
