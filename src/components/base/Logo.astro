---
// Brand logo, inlined from src/assets/brand/*.svg (replace those files to swap the logo; keep names,
// no style="" attributes). Size via CSS height on the class you pass.
import Quer from '../../assets/brand/raumstrom-logo-quer.svg';
import QuerNegativ from '../../assets/brand/raumstrom-logo-quer-negativ.svg';
import Gestapelt from '../../assets/brand/raumstrom-logo-gestapelt.svg';
import Zeichen from '../../assets/brand/raumstrom-zeichen.svg';
import ZeichenNegativ from '../../assets/brand/raumstrom-zeichen-negativ.svg';

const VARIANTEN = {
  quer: Quer,
  'quer-negativ': QuerNegativ,
  gestapelt: Gestapelt,
  zeichen: Zeichen,
  'zeichen-negativ': ZeichenNegativ,
} as const;

interface Props {
  variante?: keyof typeof VARIANTEN;
  /** Accessible name. Pass an empty string when the logo sits next to the visible name. */
  label?: string;
  class?: string;
}
const { variante = 'quer', label = 'RAUMSTROM', class: className } = Astro.props;
const Svg = VARIANTEN[variante];
---
<Svg class:list={['logo', `logo-${variante}`, className]} focusable="false" role={label ? 'img' : undefined} aria-label={label || undefined} aria-hidden={label ? undefined : 'true'} />

<style>
  :global(.logo) {
    width: auto;
    height: var(--logo-h, 2rem);
  }
</style>
