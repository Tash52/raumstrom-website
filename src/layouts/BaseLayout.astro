---
// Base layout (design-system): fonts, skip link, header, main, footer.
// No style attributes and no inline scripts (CSP). Page content goes into the default slot.
import { Font, fontData } from 'astro:assets';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Motion from '../components/sections/Motion.astro';
import type { NavEintrag } from '../components/layout/navigation.ts';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Hide header and footer (e.g. full-screen planner). Skip link and main stay. */
  ohneKopfFuss?: boolean;
  /** Styleguide preview only: explicit navigation entries. */
  navigation?: NavEintrag[];
  anfrage?: NavEintrag | null;
}
const { title, description, noindex = false, ohneKopfFuss = false, navigation, anfrage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Preload exactly two files: Archivo Latin (variable, all headings and text) and Plex Mono Regular Latin.
// fontData lists files in the order of the variants in astro.config.mjs (first = Latin).
const preloads = [fontData['--font-archivo']?.[0], fontData['--font-plex-mono']?.[0]].map((f) => f?.src[0]?.url);
if (preloads.some((u) => !u)) throw new Error('Font-Preload: Schriftdateien fehlen (fonts in astro.config.mjs prüfen)');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F4F1EB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloads.map((url) => <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />)}
    <Font cssVariable="--font-archivo" />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body>
    <SkipLink />
    {!ohneKopfFuss && <Header eintraege={navigation} anfrage={anfrage} />}
    <main id="inhalt" tabindex="-1">
      <slot />
    </main>
    {!ohneKopfFuss && <Footer />}
    <Motion />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
