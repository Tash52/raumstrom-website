{
  "name": "raumstrom-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev",
    "build": "npm run scan:wording && node scripts/check-launch.mjs && node scripts/astro.mjs build",
    "build:staging": "npm run scan:wording && node scripts/check-launch.mjs --allow-placeholders && node scripts/astro.mjs build",
    "start": "node server/server.mjs",
    "check": "node scripts/astro.mjs check",
    "check:launch": "node scripts/check-launch.mjs",
    "platzhalter": "node scripts/check-launch.mjs --allow-placeholders --write-platzhalter",
    "scan:wording": "node scripts/wording-scan.mjs",
    "licenses": "node scripts/licenses.mjs",
    "trend-schema": "node scripts/trend-schema.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "npm run test:unit && npm run test:hooks",
    "test:unit": "vitest run",
    "test:hooks": "node --test .claude/hooks/agent-guard.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/node": "11.1.13",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.5",
    "astro": "7.4.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.10",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
